# /etc/hls-cdn/cdn.env — настройки CDN (0600 root). Заполненный файл не коммитить.
# Адрес основного сервера: домен и, если сервер не в корне, путь (схема по умолчанию https).
SM_SITE_URL=site.example.org
# Токен CDN для /internal/hls/* (= HLS_CDN_TOKEN в .env сайта)
HLS_CDN_TOKEN=
# Секрет подписи ссылок (= HLS_SIGN_SECRET в .env сайта): только A-Z a-z 0-9 . _ ~ + / = -, не короче 16
HLS_SIGN_SECRET=
# Домен CDN и origin сайта для CORS
HLS_CDN_DOMAIN=cdn.example.org
HLS_CORS_ORIGIN=https://site.example.org
# Почта для Let's Encrypt
CERTBOT_EMAIL=admin@example.org
# Необязательное
#HLS_ROOT=/srv/hls
#HLS_EVICT_HIGH=85
#HLS_EVICT_LOW=80
#HLS_EVICT_MIN_IDLE=7200
#HLS_EVICT_STATE=/var/lib/hls-evict
#HLS_ACCESS_LOG=/var/log/nginx/hls-access.log
# Холодный архив на Google Drive (docs/HLS.md §17, README «Архив на Google Drive»). Пусто — архива нет.
# remote из rclone.conf, обязательно crypt поверх drive, например gdrive-crypt:hls
HLS_ARCHIVE_REMOTE=
HLS_RCLONE_CONFIG=/etc/hls-cdn/rclone.conf
# Ограничение скорости выгрузки в архив (формат rclone --bwlimit, например 20M или "08:00,10M 23:00,off"); пусто — без ограничения
HLS_ARCHIVE_BWLIMIT=
# Как часто спрашивать сайт о возврате из архива, секунды
HLS_RESTORE_POLL_S=15
#HLS_ARCHIVE_QUEUE=/var/lib/hls-archive-queue
# Просмотр прямо из архива (docs/HLS.md §20, README «Просмотр прямо из архива»): 1 — вытесненная версия играет из Google Drive,
# пока hls-restore возвращает её на диск (служба hls-archive-serve, nginx @hls_archive). Нужен заданный HLS_ARCHIVE_REMOTE
# и обязательно свой Google API client_id в rclone.conf (со встроенным в rclone — rateLimitExceeded при перемотке).
# На сайте тоже включить: HLS_ARCHIVE_STREAM=true в .env.
HLS_ARCHIVE_STREAM=0
# Кэш прочитанного из архива, ГБ (целое; /var/cache/hls-archive на системном диске, не в HLS_ROOT)
HLS_ARCHIVE_CACHE_GB=20
