# /etc/hls-cdn/cdn.env — настройки CDN (0600 root). Заполненный файл не коммитить.
# Адрес основного сервера: домен и, если сервер не в корне, путь (схема по умолчанию https).
SM_SITE_URL=site.example.org
# Токен CDN для /internal/hls/* (= HLS_CDN_TOKEN в .env сайта)
HLS_CDN_TOKEN=
# Секрет подписи ссылок (= HLS_SIGN_SECRET в .env сайта): только A-Z a-z 0-9 . _ ~ + / = -, не короче 16
HLS_SIGN_SECRET=
# Домен CDN и origin сайта для CORS
HLS_CDN_DOMAIN=cdn.example.org
HLS_CORS_ORIGIN=https://site.example.org
# Почта для Let's Encrypt
CERTBOT_EMAIL=admin@example.org
# Необязательное
#HLS_ROOT=/srv/hls
#HLS_EVICT_HIGH=85
#HLS_EVICT_LOW=80
#HLS_EVICT_MIN_IDLE=7200
#HLS_EVICT_STATE=/var/lib/hls-evict
#HLS_ACCESS_LOG=/var/log/nginx/hls-access.log
