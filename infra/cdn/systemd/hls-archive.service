[Unit]
Description=Suslik Media CDN: копия v1 в холодный архив (hls-archive.sh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hls-cdn/hls-archive.sh
Nice=10
IOSchedulingClass=idle
# rclone обновляет токен Google в rclone.conf — /etc/hls-cdn должен быть доступен на запись
Environment=RCLONE_CACHE_DIR=/var/cache/hls-rclone
CacheDirectory=hls-rclone
ProtectSystem=strict
ReadWritePaths=/var/lib/hls-evict -/var/lib/hls-archive-queue /etc/hls-cdn
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
