# Скопируйте этот файл в .env и укажите собственные значения.
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
SITE_PASSWORD=choose_a_strong_shared_password
# Разрешить вход по общему паролю (true — по умолчанию; false — только Discord)
# PASSWORD_AUTH_ENABLED=true
ALLDEBRID_API_KEY=
# Для production-сайта, доступного только по HTTPS, обязательно установите true.
COOKIE_SECURE=true
# Если Node.js запущен за Nginx (или другим reverse proxy), установите 1 (или true):
# это позволяет Express определять настоящий IP клиента (для rate limit и счётчиков),
# а также корректно определять HTTPS-протокол.
TRUST_PROXY=1
# Если сайт развёрнут в подпути (например, https://домен/media/):
# SITE_PREFIX=/media

# --- Интеграция с Discord (OAuth2 и проверка ролей на сервере) ---
# Создайте приложение в https://discord.com/developers/applications
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=abcdef1234567890abcdef1234567890
# Токен бота (создаётся во вкладке Bot приложения, без прав, для проверки участников):
# DISCORD_BOT_TOKEN=MTA...
# ID Discord-сервера (гильдии), на котором проверяется членство:
# DISCORD_GUILD_ID=123456789012345678
# ID ролей с доступом к медиатеке (через запятую):
# DISCORD_ROLE_ALLOW=111222333444,555666777888
# ID ролей администратора (полный доступ, удаление чужих раздач):
# DISCORD_ROLE_ADMIN=999888777666
# Белый список Discord User ID (доступны всегда, даже без роли):
# DISCORD_ALLOWED_USERS=123456789,987654321
# Discord ID владельца проекта (всегда роль admin):
# DISCORD_OWNER_ID=123456789
# Переопределение URL перенаправления (по умолчанию вычисляется из запроса / HOST):
# DISCORD_REDIRECT_URI=https://your-site.com/api/auth/discord/callback

# Необязательно: ключ API TMDB для постеров фильмов и сериалов (themoviedb.org)
TMDB_API_KEY=

# Необязательно: папка для sessions.json и кэшей (по умолчанию — папка приложения)
# DATA_DIR=/var/lib/suslik-media

# --- Поиск по трекерам (вкладка «Поиск») ---
# Встроенные провайдеры: apibay (TPB), yts, nyaa. Через Prowlarr/Jackett подключаются rutracker, rutor, 1337x и др.
# SEARCH_PROVIDERS=rutor,rutracker,kinozal,nnmclub,prowlarr,jackett,apibay,nyaa   (yts выключен: yts.mx часто недоступен)
# PROWLARR_URL=http://127.0.0.1:9696
# PROWLARR_API_KEY=
# JACKETT_URL=http://127.0.0.1:9117
# JACKETT_API_KEY=
# Если домен заблокирован, укажите зеркало:
# APIBAY_URL=https://apibay.org
# YTS_URL=https://yts.mx
# NYAA_URL=https://nyaa.si

# --- Русскоязычные трекеры (в выдаче идут первыми, помечены «RU») ---
# rutor: работает без аккаунта; несколько зеркал через запятую, берётся первое отвечающее
# RUTOR_URL=https://rutor.info,https://rutor.is
# rutracker.org: логин/пароль ИЛИ cookie из браузера (надёжнее, если на входе капча)
# RUTRACKER_USER=
# RUTRACKER_PASS=
# RUTRACKER_COOKIE=bb_session=...
# RUTRACKER_URL=https://rutracker.org
# kinozal.tv: логин/пароль ИЛИ cookie (uid=...; pass=...)
# KINOZAL_USER=
# KINOZAL_PASS=
# KINOZAL_COOKIE=uid=...; pass=...
# KINOZAL_URL=https://kinozal.tv
# RuTracker и Kinozal без аккаунта — через свой TorAPI (https://github.com/Lifailon/TorAPI), см. TORAPI.md.
# Используется для трекера, у которого выше не задан аккаунт/cookie.
# TORAPI_URL=http://127.0.0.1:8443
# TORAPI_TIMEOUT_MS=20000
# NNM-Club: работает без аккаунта; если сайт потребует вход — логин/пароль ИЛИ cookie
# NNMCLUB_USER=
# NNMCLUB_PASS=
# NNMCLUB_COOKIE=
# NNMCLUB_URL=https://nnmclub.to
# При смене вёрстки включите SEARCH_DEBUG=1: в лог попадёт начало ответа, по нему легко поправить парсер
# SEARCH_DEBUG=1

# Cloudflare: если rutracker/kinozal отвечают страницей «Just a moment…», поставьте FlareSolverr и укажите его адрес
#   docker run -d --name flaresolverr --restart unless-stopped -p 127.0.0.1:8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# FLARESOLVERR_URL=http://127.0.0.1:8191
# RUTRACKER_COOKIE можно указать и просто значением bb_session (0-123456-abc…): имя добавится само

# Удаление раздачи только с устройства, которое её добавило (false — выключить)
# OWNER_LOCK=true

# Обновления приложений: файлы .apk / .msi кладутся в папку updates/ (см. UPDATES.md).
# UPDATES_DIR=/путь/к/updates        # по умолчанию updates/ рядом с server.js (или в DATA_DIR)
# UPDATE_TOKEN=длинная_случайная_строка   # включает загрузку по сети: POST /api/app/upload

# Видео отдаёт nginx, а не Node (сначала настройте nginx по NGINX-MIRROR.md)
# MIRROR_ACCEL=1
# Сколько миллисекунд переиспользовать ответ AllDebrid для библиотеки (несколько устройств сразу = один запрос)
# LIBRARY_CACHE_MS=20000

# Код тестировщика: устройства, где он введён в «Настройках», получают бета-версии (updates/beta/)
# BETA_CODE=придумайте-длинный-код

# --- «Определить через ИИ» в карточке раздачи (services/aititle.js) ---
# Ключ Gemini API (https://aistudio.google.com/apikey). Без ключа кнопки нет. Только здесь, не в клиентах.
# GEMINI_API_KEY=
# AI_TITLE_MODEL=gemini-3.5-flash-lite
# Кулдаун на пользователя (минуты) и общий дневной лимит вызовов модели:
# AI_TITLE_COOLDOWN_MIN=15
# AI_TITLE_DAILY_MAX=200
