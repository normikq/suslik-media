# /etc/suslik-encoder.env — настройки кодировщика HLS (права 600, root). Образец; заполнить и запустить install.sh ещё раз.
# Все переменные — encoder/README.md.

# Адрес сайта со схемой (и путём, если сервер не в корне)
SM_SITE_URL=https://site.example.org
# Тот же, что HLS_WORKER_TOKEN в .env сайта
HLS_WORKER_TOKEN=

# CDN: пользователь hls-upload (infra/cdn, install.sh); ключ install.sh создаст сам
SM_CDN_SSH=hls-upload@cdn.example.org
SM_CDN_SSH_KEY=/var/lib/suslik-encoder/.ssh/hls-upload
# SM_CDN_SSH_PORT=2222

SM_ENCODER=nvenc
SM_FFMPEG=/usr/bin/ffmpeg
SM_FFPROBE=/usr/bin/ffprobe
SM_WORK_DIR=/var/lib/suslik-encoder/work
SM_LOG_DIR=/var/log/suslik-encoder

# Необязательные (значения по умолчанию):
# SM_MAX_SOURCE_GB=40
# SM_CQ=24
# SM_NVENC_PRESET=p5
# HDR → SDR: auto (libplacebo на видеокарте, иначе cpu) | libplacebo | cpu; устройство Vulkan — индекс или часть имени
# SM_TONEMAP=auto
# SM_VULKAN_DEVICE=3060
