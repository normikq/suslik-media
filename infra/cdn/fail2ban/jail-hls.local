# /etc/fail2ban/jail.d/hls-cdn.local
[sshd]
enabled  = true
# журнал sshd — из journald: в свежей Ubuntu /var/log/auth.log нет, и с backend=auto fail2ban не стартует
backend  = systemd
maxretry = 5
findtime = 10m
bantime  = 1h

[nginx-hls-sig]
enabled  = true
port     = http,https
filter   = nginx-hls-sig
logpath  = /var/log/nginx/hls-access.log
maxretry = 30
findtime = 5m
bantime  = 1h
