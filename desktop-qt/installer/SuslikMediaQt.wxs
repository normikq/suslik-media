<?xml version="1.0" encoding="utf-8"?>
<!--
  Установщик Qt-версии (WiX 3). Ставится для текущего пользователя, без прав администратора,
  в %LOCALAPPDATA%\Programs\<папка>. У Kotlin-версии свой UpgradeCode и своя папка: с 3.0.0 её удаляет «Suslik Media Setup.exe»
  перед установкой (installer/setup/Work.cs), сам MSI её не трогает. Название в «Пуске» — «Suslik Media», как у неё.
  Файлы программы — из heat (files.wxs), собирает build-msi.sh. libmpv-2.dll в MSI нет: её докачивает программа (MpvInstall).
  Переменные: Version, Product, UpgradeCode, Folder, Icon, Src.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="$(var.Product)" Language="1049" Codepage="1251" Version="$(var.Version)"
           Manufacturer="Suslik Media" UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Platform="x64" Languages="1049" SummaryCodepage="1251" Description="$(var.Product) $(var.Version)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Та же или более новая версия поверх: сначала удаляется прежняя копия этого же приложения. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Уже установлена более новая версия [ProductName]." />

    <Icon Id="app.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Папку программы при обновлении передаёт само приложение (INSTALLDIR, Updater.cpp) -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="$(var.Folder)" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Shortcuts" Guid="*">
        <!-- Без Icon=: значок берётся из самого SuslikMediaQt.exe (IDI_ICON1, app.rc). Иконка из таблицы MSI
             (кэш в C:\Windows\Installer) после обновления/переустановки терялась — ярлык показывал пустой значок. -->
        <Shortcut Id="MenuShortcut" Directory="ProgramMenuFolder" Name="$(var.Product)" Target="[INSTALLDIR]SuslikMediaQt.exe"
                  WorkingDirectory="INSTALLDIR" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="$(var.Product)" Target="[INSTALLDIR]SuslikMediaQt.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Suslik Media\$(var.Folder)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Двойной щелчок по MSI (полный интерфейс): после установки открыть программу. Обновление из программы
         (/passive) её не трогает — программу перезапускает сценарий Updater. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]SuslikMediaQt.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize">NOT REMOVE AND UILevel = 5</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
